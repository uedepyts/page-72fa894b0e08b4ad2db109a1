 grid;grid-template-columns: 1fr;gap: 1.25rem}\n.step-card {border: 3px solid #1a1a24;background-color: #ffffff;padding: 1.5rem}\n.step-card h3 {font-size: 1.15rem;font-weight: 700;margin-bottom: 0.5rem;display: flex;align-items: center;gap: 0.5rem}\n.step-num {display: inline-flex;align-items: center;justify-content: center;width: 26px;height: 26px;background-color: #6a00f5;color: #ffffff;font-size: 0.85rem;font-weight: 800}\n.step-card p {color: #4a4a58;font-size: 0.95rem}\n.clients-panel {border: 3px solid #1a1a24;background-color: #ffffff;padding: 2rem}\n.clients-grid {display: grid;grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));gap: 1.25rem;margin-top: 1rem}\n.client-box {border: 2px solid #1a1a24;padding: 1.25rem;background-color: #f7f7fa}\n.client-box h4 {font-size: 1.05rem;margin-bottom: 0.4rem;color: #1a1a24}\n.client-box p {font-size: 0.88rem;color: #555566;margin-bottom: 0.8rem}\n.client-link {font-size: 0.85rem;font-weight: 700;color: #6a00f5;border-bottom: 1px solid #6a00f5}\n.faq-stack {display: flex;flex-direction: column;gap: 1rem}\n.faq-item {border: 3px solid #1a1a24;background-color: #ffffff}\n.faq-item summary {padding: 1.25rem 1.5rem;font-weight: 700;font-size: 1.05rem;cursor: pointer;list-style: none;position: relative;outline: none;user-select: none}\n.faq-item summary::-webkit-details-marker {display: none}\n.faq-item summary::after {content: \"+\";position: absolute;right: 1.5rem;top: 1.15rem;font-size: 1.4rem;line-height: 1;color: #6a00f5}\n.faq-item[open] summary::after {content: \"-\"}\n.faq-content {padding: 0 1.5rem 1.25rem 1.5rem;border-top: 2px dashed #dedee6;color: #444452;font-size: 0.95rem;line-height: 1.6}\n.faq-content p {margin-top: 0.75rem}\n.site-footer {border-top: 3px solid #1a1a24;padding: 2.5rem 0 1rem;color: #666677;font-size: 0.85rem;margin-top: 4rem}\n@media (max-width: 900px) {\n  .layout {flex-direction: column}\n  .sidebar-nav {width: 100%;height: auto;position: relative;border-right: none;border-bottom: 3px solid #1a1a24;padding: 1.5rem}\n  .sidebar-menu {flex-direction: row;flex-wrap: wrap;gap: 0.5rem}\n  .sidebar-footer {display: none}\n  .main-content {padding: 2rem 1.25rem}\n  .hero-section {padding: 1.5rem}\n  .hero-title-group h1 {font-size: 1.8rem}\n}\n</style><div class=\"layout\">\n  <nav class=\"sidebar-nav\" aria-label=\"页面快速导航\">\n    <div>\n      <div class=\"brand-badge\">HKSSNETWORK 导览</div>\n      <ul class=\"sidebar-menu\">\n        <li><a href=\"#story\">起点与历程</a></li>\n        <li><a href=\"#plans\">订阅计划方案</a></li>\n        <li><a href=\"#setup\">四步上手指引</a></li>\n        <li><a href=\"#clients\">常用客户端工具</a></li>\n        <li><a href=\"#faq\">常见问题答疑</a></li>\n      </ul>\n    </div>\n    <div class=\"sidebar-footer\">\n      像跟老朋友喝茶一样，把复杂的配置理得干干净净。\n    </div>\n  </nav>\n\n  <main class=\"main-content\">\n    <section class=\"hero-section\" id=\"story\">\n      <div class=\"hero-title-group\">\n        <h1>HKSSNetwork 随行网络记事</h1>\n        <div class=\"hero-subtitle\">把日常联机的琐碎与焦躁，整理成一条平稳的时间线</div>\n      </div>\n      <div class=\"timeline\">\n        <div class=\"timeline-item\">\n          <div class=\"timeline-time\">STEP 01 · 碰壁期</div>\n          <h3>总在关键时刻转圈圈的烦恼</h3>\n          <p>查资料查到一半图片加载卡住，海外项目库拉取超时，或者跟远方朋友打一盘游戏频频掉线。很多时候我们想要的不过是安安静静把手头的事做完。</p>\n        </div>\n        <div class=\"timeline-item\">\n          <div class=\"timeline-time\">STEP 02 · 梳理期</div>\n          <h3>剔除繁杂，只留清晰可靠的通道</h3>\n          <p>我们把冗余的概念收起来，给不同使用强度的朋友整理出清晰的订阅分级，不再需要猜哪个参数适合自己，开箱即用就好。</p>\n        </div>\n        <div class=\"timeline-item\">\n          <div class=\"timeline-time\">STEP 03 · 此时此刻</div>\n          <h3>随时为你守候的 HKSSNetwork</h3>\n          <p>无论你是手机随手翻翻资讯，还是整台电脑在工位连续调取数据，选好适合你的节奏，我们把连接的事情照顾好。</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section-block\" id=\"plans\">\n      <div class=\"section-header\">\n        <h2>挑选符合你日常的方案</h2>\n        <p>没有任何强制绑定，依据你的月度使用量与随身设备数，挑最舒服的那一档即可。</p>\n      </div>\n\n      <div class=\"plans-stack\">\n        <article class=\"plan-card\">\n          <div class=\"plan-top\">\n            <div class=\"plan-name-wrap\">\n              <span class=\"plan-name\">基础版</span>\n            </div>\n            <div class=\"plan-prices\">\n              <div class=\"plan-price-monthly\">¥15 / 月</div>\n              <div class=\"plan-price-annual\">按年付仅需 ¥150/年</div>\n            </div>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 100GB 基础流量额度</li>\n            <li>支持 3 台设备同时保持在线</li>\n            <li>满足常规流媒体与日常网页浏览</li>\n            <li>接入标准普通线路节点池</li>\n          </ul>\n          <a href=\"#\" class=\"plan-action\">选择基础版</a>\n        </article>\n\n        <article class=\"plan-card highlight\">\n          <div class=\"plan-top\">\n            <div class=\"plan-name-wrap\">\n              <span class=\"plan-name\">旗舰版</span>\n              <span class=\"plan-tag\">多数朋友的选择</span>\n            </div>\n            <div class=\"plan-prices\">\n              <div class=\"plan-price-monthly\">¥35 / 月</div>\n              <div class=\"plan-price-annual\">按年付仅需 ¥350/年</div>\n            </div>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 300GB 充裕流量配额</li>\n            <li>支持 5 台常用设备协同连入</li>\n            <li>全节点原生流媒体顺畅播放支持</li>\n            <li>针对联机游戏优化的专线传输路径</li>\n            <li>7×24 小时工单沟通响应</li>\n          </ul>\n          <a href=\"#\" class=\"plan-action\">选择旗舰版</a>\n        </article>\n\n        <article class=\"plan-card\">\n          <div class=\"plan-top\">\n            <div class=\"plan-name-wrap\">\n              <span class=\"plan-name\">团队版</span>\n            </div>\n            <div class=\"plan-prices\">\n              <div class=\"plan-price-monthly\">¥85 / 月</div>\n              <div class=\"plan-price-annual\">按年付仅需 ¥850/年</div>\n            </div>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 1000GB 大容量共享流量</li>\n            <li>支持 20 台设备共同在线协作</li>\n            <li>分配专属宽通道高负载节点</li>\n            <li>协助团队按需规划分流路由</li>\n            <li>专人跟进日常配置与异常反馈</li>\n          </ul>\n          <a href=\"#\" class=\"plan-action\">选择团队版</a>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"section-block\" id=\"setup\">\n      <div class=\"section-header\">\n        <h2>四步搞定初次上手</h2>\n        <p>不必担心技术门槛，顺着以下步骤走，几分钟就能让网络通畅起来。</p>\n      </div>\n\n      <div class=\"steps-card-grid\">\n        <div class=\"step-card\">\n          <h3><span class=\"step-num\">1</span> 选好计划并获取订阅链接</h3>\n          <p>在上方选好适合你的套餐后，在用户控制台中复制专属于你的一串订阅链接，请妥善保管好这串字符，不要发到公开讨论群里。</p>\n        </div>\n        <div class=\"step-card\">\n          <h3><span class=\"step-num\">2</span> 准备好系统对应的客户端</h3>\n          <p>在你的电脑或手机上准备好能够读取订阅配置的工具软件，主流系统都有轻巧且成熟的开源方案可供选用。</p>\n        </div>\n        <div class=\"step-card\">\n          <h3><span class=\"step-num\">3</span> 导入订阅并下载节点列表</h3>\n          <p>打开软件，找到“添加订阅”或“从剪贴板导入”，将链接粘贴进去点击更新，你就会看到按区域整齐排列好的可用接入点。</p>\n        </div>\n        <div class=\"step-card\">\n          <h3><span class=\"step-num\">4</span> 选定分流规则并开启连接</h3>\n          <p>建议选择“绕过大陆”或“规则分流”模式，这样访问平时常看的国内网站依然走本地宽带，海外请求则自动分流，顺滑不打架。</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section-block\" id=\"clients\">\n      <div class=\"section-header\">\n        <h2>客户端与生态工具说明</h2>\n        <p>HKSSNetwork 采用标准协议交付，你可以自由挑选自己用得最顺手的软件配合使用。</p>\n      </div>\n\n      <div class=\"clients-panel\">\n        <p>我们本身不分发经过二次封装的软件安装包，建议大家直接前往各大客户端的官方开源发布页或应用商店获取纯净版本：</p>\n        <div class=\"clients-grid\">\n          <div class=\"client-box\">\n            <h4>Windows 系统</h4>\n            <p>可选用主流规则分流客户端，图形界面直观，适合日常办公与外接屏多任务使用。</p>\n            <a href=\"#\" class=\"client-link\">查看配置建议</a>\n          </div>\n          <div class=\"client-box\">\n            <h4>macOS 设备</h4>\n            <p>支持原生深色模式与菜单栏常驻的常用工具，对多显示器和休眠唤醒友好。</p>\n            <a href=\"#\" class=\"client-link\">查看配置建议</a>\n          </div>\n          <div class=\"client-box\">\n            <h4>Android 手机</h4>\n            <p>可采用开源客户端，支持按应用分流，不影响外卖和打车软件的本地定位。</p>\n            <a href=\"#\" class=\"client-link\">查看配置建议</a>\n          </div>\n          <div class=\"client-box\">\n            <h4>iOS / iPadOS</h4>\n            <p>可通过外区应用商店获取兼容通用订阅的实用工具，一键导入扫码即用。</p>\n            <a href=\"#\" class=\"client-link\">查看配置建议</a>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section-block\" id=\"faq\">\n      <div class=\"section-header\">\n        <h2>常被问到的那些事</h2>\n        <p>提前把可能遇上的疑问解答清楚，让你心里更有底。</p>\n      </div>\n\n      <div class=\"faq-stack\">\n        <details class=\"faq-item\">\n          <summary>购买之后流量是立刻生效吗？按自然月还是按订购周期结算？</summary>\n          <div class=\"faq-content\">\n            <p>确认支付后订阅链接会立即生成并载入对应流量。额度是按你的实际订购日为周期滚动的，比如 15 号开通，就会在下个月的 15 号进行下一周期的流量重置，不是按自然月第一天抹零。</p>\n          </div>\n        </details>\n\n        <details class=\"faq-item\">\n          <summary>设备同时在线数量是怎么统计的？换设备需要手动解绑吗？</summary>\n          <div class=\"faq-content\">\n            <p>系统是按照短时间内“同时发起数据请求的独立连接端”进行判断的。如果你家里有电脑、随身有手机和平板，只要不同时超出套餐所允许的并发数就能随意切换，不需要在后台来回解绑。</p>\n          </div>\n        </details>\n\n        <details class=\"faq-item\">\n          <summary>更新订阅时提示“更新失败”或者列表为空是怎么回事？</summary>\n          <div class=\"faq-content\">\n            <p>这种情况大多是因为本地网络在解析订阅域名时遇到了暂时的 DNS 污染，或是订阅链接前后不小心多复制了一个空格。可以先检查链接是否完整，或试着用手机热点重试一次更新。</p>\n          </div>\n        </details>\n\n        <details class=\"faq-item\">\n          <summary>如果这个月流量提前用完了，能单独补充流量包吗？</summary>\n          <div class=\"faq-content\">\n            <p>可以的。如果你碰巧遇到需要下载大文件、流量提前见底的情况，可以登录管理面板直接重置当期周期，或者按照提示增购临时附加数据包，不需要重新购买整套方案。</p>\n          </div>\n        </details>\n\n        <details class=\"faq-item\">\n          <summary>基础版与旗舰版在体验上最直观的差别在哪里？</summary>\n          <div class=\"faq-content\">\n            <p>除了每月可用额度和同时在线设备上限不同之外，旗舰版规划了针对联机互动和高画质影音优化的通道，在晚高峰网络拥塞时段表现更从容，排障沟通也能获得更优先的跟进。</p>\n          </div>\n        </details>\n      </div>\n    </section>\n\n    <footer class=\"site-footer\">\n      <p>© HKSSNetwork. 保持好奇，通达开阔的世界。所有套餐规则与指引请以个人实际网络环境为准。</p>\n    </footer>\n  </main>\n</div>",
